{
  "name": "gme-live-wire",
  "version": "0.1.0",
  "private": true,
  "description": "GME LIVE WIRE — GameStop Intelligence Terminal",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
